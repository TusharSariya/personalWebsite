{
	"name": "personalWebsite",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@cloudflare/workers-types": "^4.20251213.0",
			"hono": "^4.8.2",
			"@orpc/server": "^1.13.14",
			"@orpc/openapi": "^1.13.14",
			"@orpc/zod": "^1.13.14",
			"better-auth": "1.6.11",
			"alchemy": "^0.91.2",
			"wrangler": "^4.77.0",
			"next-themes": "^0.4.6",
			"@orpc/tanstack-query": "^1.13.14",
			"@orpc/client": "^1.13.14",
			"@tanstack/react-form": "^1.28.0",
			"@types/react-dom": "^19.2.3",
			"@better-auth/expo": "1.6.11"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo -F @personalWebsite/infra -F native dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"debug:native": "cd apps/native && npx expo-doctor && npx expo config --type public",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F @personalWebsite/infra dev",
		"db:push": "turbo -F @personalWebsite/db db:push",
		"db:studio": "turbo -F @personalWebsite/db db:studio",
		"db:generate": "turbo -F @personalWebsite/db db:generate",
		"db:migrate": "turbo -F @personalWebsite/db db:migrate",
		"deploy": "turbo -F @personalWebsite/infra deploy",
		"destroy": "turbo -F @personalWebsite/infra destroy",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@personalWebsite/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@cloudflare/workers-types": "catalog:",
		"@personalWebsite/config": "workspace:*",
		"@types/node": "^22.13.14",
		"turbo": "^2.9.16",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.11",
	"overrides": {
		"react": "19.1.0",
		"react-dom": "19.1.0"
	}
}
