# Local dev: mock mode (no API or database)
VITE_USE_MOCK_FEED=true
VITE_USE_MOCK_AUTH=true

# Real API (set false for production; Alchemy sets false on deploy)
# VITE_USE_MOCK_FEED=false
# VITE_USE_MOCK_AUTH=false

# Local API URL (Alchemy sets this from the server Worker URL on deploy)
VITE_SERVER_URL=http://localhost:3000
