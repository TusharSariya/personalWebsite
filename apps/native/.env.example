# Use mock feed data — no API or database required
EXPO_PUBLIC_USE_MOCK_FEED=true

# Dev sign-in with admin / admin (no API)
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Only needed when EXPO_PUBLIC_USE_MOCK_FEED=false
# Use your Mac LAN IP (not localhost) when testing on a physical phone
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
