# Required for deploy and Alchemy secret encryption
ALCHEMY_PASSWORD=

# Cloudflare (local deploy + CI uses GitHub secrets instead)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=

# Created after first deploy with CloudflareStateStore
ALCHEMY_STATE_TOKEN=

# Supabase Transaction pooler URI (port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: separate DB for PR preview Workers (recommended)
DATABASE_URL_STAGING=

# Auth
BETTER_AUTH_SECRET=

# Local dev URLs (production uses Worker.DevUrl / server.url bindings)
CORS_ORIGIN=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare workers.dev suffix for cross-subdomain auth + CORS (e.g. .your-account.workers.dev)
# Find it in Cloudflare dashboard → Workers & Pages → workers.dev subdomain
WORKERS_DEV_SUBDOMAIN=
